# ---------- Line endings (mixed Linux/Windows team) ----------
* text=auto
*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.h     text diff=cpp
*.cpp   text diff=cpp
*.cs    text diff=csharp
*.ini text
*.uproject text
*.uplugin text
*.json text
*.md text
*.csv text
*.ink text
*.txt text
*.py text

# ---------- Unreal packages: LFS + lockable (explicit, per UEGitPlugin) ----------
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap   filter=lfs diff=lfs merge=lfs -text lockable

